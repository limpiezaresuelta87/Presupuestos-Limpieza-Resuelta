// Reglas de seguridad de Firestore
// -------------------------------------------------------------
// Cómo usarlas: Firebase Console → Firestore Database → pestaña
// "Reglas" → pegar esto → Publicar.
//
// Qué hacen: solo dejan leer y escribir a los emails de la lista
// de abajo. Esta es la seguridad REAL — aunque alguien desactive
// el login en el navegador (inspeccionando el código), Firestore
// va a rechazar igual cualquier operación de un email no permitido.
//
// IMPORTANTE: mantené esta lista IGUAL a EMAILS_AUTORIZADOS en
// js/firebase-init.js. Son dos listas separadas a propósito (una
// vive en tu código, la otra en los servidores de Firebase), pero
// tienen que decir lo mismo.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esUsuarioAutorizado() {
      return request.auth != null && request.auth.token.email in [
        // EDITAR ACÁ TAMBIÉN — misma lista que en firebase-init.js
        "limpiezaresuelta87@gmail.com",
        "cpn.jauregui@gmail.com",
        "jaureguipablog@hotmail.com"
      ];
    }

    match /{document=**} {
      allow read, write: if esUsuarioAutorizado();
    }
  }
}
